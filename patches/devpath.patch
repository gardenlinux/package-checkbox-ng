+def has_dev_block_node(name):
+    """Return True if name resolves to a user-visible block-device node"""
+    try:
+        return stat.S_ISBLK(os.stat(os.path.join("/dev", name)).st_mode)
+    except (TypeError, OSError):
+        return False
